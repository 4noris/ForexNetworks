# Copy this template into a private .env and configure your own deployment.
# External notifications remain disabled until explicitly configured/enabled.
MT5_MANAGER_SERVER=127.0.0.1:443
MT5_MANAGER_LOGIN=1000
MT5_MANAGER_PASSWORD=replace_with_manager_password
MT5_MANAGER_AUTOCONNECT=true
# One Manager connection is shared by all API routes and background workers.
MT5_USER_REFRESH_SECONDS=10
MT5_POSITION_REFRESH_SECONDS=2
MT5_TICK_REFRESH_SECONDS=0.5
MT5_TICK_REFRESH_BATCH_SIZE=100
MT5_TICK_LIVE_MAX_AGE_SECONDS=30
MT5_PANELS_REFRESH_SECONDS=2
MT5_FULL_SNAPSHOT_ENABLED=true
# Optional populated group to open first in the live-risk UI.
MT5_DEFAULT_LIVE_GROUP=
MT5_LIVE_RISK_CACHE_SECONDS=60
MT5_LIVE_RISK_IP_LOOKUP_LIMIT=100
ANTIFRAUD_CACHE_SECONDS=300
ANTIFRAUD_MAX_TICK_CHECKS=3
ANTIFRAUD_BACKGROUND_SCAN_ENABLED=true
ANTIFRAUD_BACKGROUND_SCAN_SECONDS=300
MT5_GROUP_REFRESH_SECONDS=30
MT5_WATCHDOG_SECONDS=10
MT5_RECONNECT_BACKOFF_SECONDS=5

TELEGRAM_BOT_TOKEN=123456789:replace_with_botfather_token
TELEGRAM_CHAT_ID=replace_with_target_chat_id
TELEGRAM_ALERTS_ENABLED=false
TELEGRAM_RISK_ALERTS_ENABLED=false
TELEGRAM_ANTIFRAUD_ALERTS_ENABLED=false
BBOOK_SNAPSHOT_INTERVAL_SECONDS=3600
CENT_ACCOUNT_DIVISOR=100
PROFIT_ALERT_PCT_THRESHOLD=30
DOUBLE_PROFIT_PCT_THRESHOLD=100
HIGH_LOT_ALERT_THRESHOLD=1.0
ACCOUNT_LOT_ALERT_THRESHOLD=5.0
ALERT_DEDUPE_RETENTION_SECONDS=86400
LOW_DEPOSIT_ALERT_THRESHOLD=500
LOW_DEPOSIT_HIGH_PROFIT_MIN=200
LOW_DEPOSIT_PROFIT_MULTIPLE=1.5

# Optional trade-IP evidence. Separate multiple MT5 server log directories with
# a semicolon on Windows. These must be server connection/request journals,
# not Manager terminal logs or access-server connectivity logs.
MT5_SERVER_LOG_DIRS=C:\\MT5Server\\Logs;D:\\MT5Archive\\Logs
IP_GEOLOCATION_ENABLED=true

# Cache expensive 365-day P&L leader history. Live floating P&L remains live.
PERFORMANCE_CACHE_SECONDS=60

# Every 30 minutes, clear derived report/view caches, prune expired lookup and
# alert-deduplication entries, optimize SQLite, and remove stale app launcher
# logs older than 24 hours. Dated MT5 journals are retained for seven days;
# the live Manager data generation is always preserved.
RUNTIME_MAINTENANCE_INTERVAL_SECONDS=1800
APP_LOG_RETENTION_HOURS=24
MT5_JOURNAL_RETENTION_DAYS=7
AUDIT_RETENTION_DAYS=90

# Optional API configuration
# Use a long random value and keep it stable across backend restarts/replicas.
APP_SESSION_SECRET=replace_with_at_least_32_random_bytes
APP_SECRET_SALT=replace_with_a_different_long_random_value
SESSION_TTL_SECONDS=2592000
# Set true only when the application is served over HTTPS.
SESSION_COOKIE_SECURE=false
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
LOGIN_RATE_LIMIT_MAX_KEYS=10000
# Comma-separated browser origins. Leave empty when frontend and API are same-origin.
ALLOWED_ORIGINS=

# Optional Google Sheets operational-data sync. Create a Google Cloud service
# account, enable the Google Sheets API, and share the spreadsheet with that
# service account's client_email as an Editor. Keep the downloaded JSON key
# outside source control and point GOOGLE_SERVICE_ACCOUNT_FILE at it.
GOOGLE_SHEETS_ENABLED=false
GOOGLE_SHEETS_SPREADSHEET_ID=replace_with_google_spreadsheet_id
GOOGLE_SERVICE_ACCOUNT_FILE=GoogleSheet/service-account.json
# Keep the operational workbook current without creating duplicate rows.
# The default scope uses MT5_DEFAULT_LIVE_GROUP.  Use a comma-separated list
# here only when the sheet should track a different, explicitly bounded scope.
GOOGLE_SHEETS_AUTO_SYNC_ENABLED=false
GOOGLE_SHEETS_AUTO_SYNC_SECONDS=300
GOOGLE_SHEETS_AUTO_SYNC_GROUPS=

# Dealing & Risk archive. Settings are seeded once; subsequently use Analytics >
# Data Synchronization Status to change the persisted schedule without a reload.
HISTORY_WORKER_ENABLED=true
HISTORY_SYNC_INTERVAL_MINUTES=60
HISTORY_SNAPSHOT_SECONDS=300
HISTORY_RECONCILIATION_HOUR_UTC=2
# Empty uses 30 UTC days before the archive is first initialized.
HISTORY_BACKFILL_FROM=
# Semicolon-separated exact group names. Empty uses configured A/B/cent/hybrid books.
HISTORY_GROUPS=
# Independent browser operational refresh configuration (seconds).
LIVE_RISK_REFRESH_SECONDS=5
OPERATIONAL_REFRESH_SECONDS=30

# Optional: leave blank to disable database reset; set a deployment-only strong value to enable.
RMS_RESET_PASSWORD=
